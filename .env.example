# Environment Mode: development / staging / production
ENVIRONMENT=development

# Security & JWT Tokens
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Development/test only. Leave empty in production.
DEFAULT_OTP_BYPASS=
BOOTSTRAP_OWNER_PASSWORD=

# Database Configuration (PostgreSQL in Production)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=aashima_erp

# Database Connection URL (Defaults to SQLite in local dev if not set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aashima_erp
DATABASE_URL=sqlite:///d:/ashiana/aashima_erp.db
PUBLIC_BASE_URL=https://your-public-domain.example

# Business Identity & Flagship Metadata
BUSINESS_NAME=AASHIMA
BUSINESS_LEGAL_NAME=AASHIMA Women's World & AASHIMA Stitchers 'N' Drapers
SHOP_ADDRESS=581, Turab Nagar, Ghaziabad, Uttar Pradesh, 201001, India
SHOP_PHONE=+91 98102 44321
SHOP_EMAIL=contact@aashima-atelier.in
SHOP_GSTIN=09AABCA1234F1Z8

# Notification Provider Gateways (production supports fast2sms or twilio)
NOTIFICATION_PROVIDER=fast2sms
SMS_API_KEY=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
